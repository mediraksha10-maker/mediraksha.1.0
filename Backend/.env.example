# Backend Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit your real .env file — it is already in .gitignore.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Server port
PORT=5000

# Node environment: development | production
NODE_ENV=development

# Frontend URL (used for CORS in production)
FRONTEND_URL=https://your-frontend-domain.vercel.app/

# Optional comma-separated extra allowed browser origins for split deployments
CORS_ORIGINS=https://your-other-frontend-domain.com

# For split frontend/backend cookie auth, set COOKIE_SAME_SITE=none and keep HTTPS enabled.
# For same-origin deployment, strict is preferred in production.
COOKIE_SAME_SITE=strict
COOKIE_SECURE=true

# Request limits
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=30

# Set to 1 on most hosted Node platforms behind a reverse proxy/load balancer.
TRUST_PROXY=1

# JWT secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<generate_a_64_byte_hex_string>

# Groq API key (AI chatbot)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth client ID (must match Frontend VITE_GOOGLE_CLIENT_ID if Google login is enabled)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Upstash Redis REST (caching)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin secret — used to protect the doctor verification endpoint
# Set to a long random string and keep it private
ADMIN_SECRET=<generate_a_random_secret>
