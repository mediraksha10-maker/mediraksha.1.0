# Frontend Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit your real .env file — it is already in .gitignore.

# Google OAuth 2.0 Client ID
# Get this from: https://console.cloud.google.com/
# 1. Create a project → APIs & Services → Credentials → OAuth 2.0 Client IDs
# 2. Add http://localhost:5173 to Authorized JavaScript Origins (dev)
# 3. Add your production domain to Authorized JavaScript Origins (prod)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Optional. Use for split frontend/backend deployments.
# Include /api, for example: https://your-backend-domain.com/api
VITE_API_BASE_URL=
